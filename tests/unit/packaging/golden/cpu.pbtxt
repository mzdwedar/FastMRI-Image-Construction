# U-Net reconstruction, ONNX Runtime on CPU, with server-side dynamic batching.
# One request = one or more 320x320 magnitude slices; Triton merges concurrent
# requests into a single forward pass of up to max_batch_size slices.
name: "unet_model"
platform: "onnxruntime_onnx"
max_batch_size: 16

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 1, 320, 320 ]  # C, H, W (batch dim is implicit)
  }
]
output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [ 1, 320, 320 ]
  }
]

version_policy { specific { versions: [ 3 ] } }

instance_group [ { kind: KIND_CPU, count: 1 } ]

dynamic_batching {
  preferred_batch_size: [ 4, 8, 16 ]
  max_queue_delay_microseconds: 2000  # wait up to this long to fill a batch
  # Backpressure: shed load instead of queueing without bound (clients see UNAVAILABLE -> gateway 503)
  default_queue_policy {
    timeout_action: REJECT
    default_timeout_microseconds: 5000000  # reject requests that waited > 5 s
    max_queue_size: 256
  }
}

# Match the container's CPU allocation; ORT otherwise sizes its pool to the host
parameters { key: "intra_op_thread_count" value: { string_value: "4" } }
parameters { key: "inter_op_thread_count" value: { string_value: "1" } }

# No response cache: real MRI slices are never byte-identical, and a cache would
# only inflate load-test numbers.

# Run batch 1 and a full batch through the model at load so the first real request is not cold.
# (Zero data: only exercises the graph; dims exclude the batch dimension.)
model_warmup [
  {
    name: "batch_1"
    batch_size: 1
    inputs { key: "input" value: { data_type: TYPE_FP32 dims: [ 1, 320, 320 ] zero_data: true } }
  },
  {
    name: "batch_16"
    batch_size: 16
    inputs { key: "input" value: { data_type: TYPE_FP32 dims: [ 1, 320, 320 ] zero_data: true } }
  }
]

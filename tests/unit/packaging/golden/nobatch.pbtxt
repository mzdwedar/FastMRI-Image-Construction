# Same model and threads as unet_model, without dynamic batching: the baseline that
# shows what server-side batching buys under concurrent single-slice requests.
name: "unet_model_nobatch"
platform: "onnxruntime_onnx"
max_batch_size: 16

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 1, 320, 320 ]
  }
]
output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [ 1, 320, 320 ]
  }
]

version_policy { specific { versions: [ 3 ] } }

instance_group [ { kind: KIND_CPU, count: 1 } ]

parameters { key: "intra_op_thread_count" value: { string_value: "4" } }
parameters { key: "inter_op_thread_count" value: { string_value: "1" } }

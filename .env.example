# Copy to .env (gitignored) and fill in. Every variable the repo reads is listed here; later modules append theirs.

# --- Data download (fastmri_knee.data.prepare, task F9). Signed URL from the FastMRI site; never commit it.
url=

# --- MLflow (task P1). Unset = local file store ./mlruns. `make up` serves it on :5001.
# MLFLOW_TRACKING_URI=http://localhost:5001

# --- Compose (legacy stack until the gateway lands)
SERVER_CPUS=4              # CPU budget given to each serving backend
GF_ADMIN_PASSWORD=change-me

# --- Legacy FastAPI app
CHECKPOINT_PATH=/artifacts/model.ckpt
NUM_THREADS=4

# --- Training job script (deploy/jobs/workloads.sh)
TRAIN_RESULTS_FILE=results/training_results.json

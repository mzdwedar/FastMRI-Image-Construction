{
  "uid": "fastmri-service",
  "title": "Service overview",
  "tags": [
    "fastmri"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Triton",
      "type": "link",
      "url": "/d/fastmri-triton",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Infrastructure",
      "type": "link",
      "url": "/d/fastmri-infra",
      "icon": "dashboard",
      "keepTime": true
    }

  "panels": [
    {
      "type": "stat",
      "title": "Availability (30 d)",
      "description": "Non-5xx / all responses on /v1/*; 4xx count as good. SLO 99.5 %. Covers the data that exists if Prometheus holds less than 30 d.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          },
          "min": 0.9,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (sum(increase(gateway_requests_total{route=~\"/v1/.*\",status_class=\"5xx\"}[30d])) / sum(increase(gateway_requests_total{route=~\"/v1/.*\"}[30d])))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Error budget left",
      "description": "1 minus the share of the 0.5 % error budget already spent. Negative = SLO breached.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - ((1 - (1 - (sum(increase(gateway_requests_total{route=~\"/v1/.*\",status_class=\"5xx\"}[30d])) / sum(increase(gateway_requests_total{route=~\"/v1/.*\"}[30d]))))) / 0.0050000000000000044)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Model ready",

      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": true
          },
          "links": [
            {
              "title": "Logs for this route",
              "url": "/explore?left={%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B{%22refId%22%3A%22A%22%2C%22expr%22%3A%22{service%3D%5C%22gateway%5C%22}%20%7C%20json%20%7C%20route%3D%5C%22${__field.labels.route}%5C%22%22}%5D%2C%22range%22%3A{%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22}}"
            }
          ]
        },
        "overrides": []
      },
      "options": {

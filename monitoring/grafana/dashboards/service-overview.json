  "panels": [
    {
      "type": "stat",
      "title": "/v1/infer < 500 ms (30 d)",
      "description": "Share of /v1/infer requests under < 500 ms; SLO 99%. Covers the data that exists if Prometheus holds less than 30 d.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "min": 0.8,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(gateway_request_duration_seconds_bucket{route=\"/v1/infer\",le=\"0.5\"}[30d])) / sum(increase(gateway_request_duration_seconds_count{route=\"/v1/infer\"}[30d]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "/v1/infer budget left",
      "description": "1 minus the share of the 1% slow-request allowance already used. Negative = SLO breached.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - ((1 - (sum(increase(gateway_request_duration_seconds_bucket{route=\"/v1/infer\",le=\"0.5\"}[30d])) / sum(increase(gateway_request_duration_seconds_count{route=\"/v1/infer\"}[30d])))) / 0.01)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "id": 2
    },
